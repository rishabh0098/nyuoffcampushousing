// NYU Off-Campus Housing Portal — data model.
// Postgres via Prisma, deployed on Vercel (KTD1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingStatus {
  Active
  Inactive
}

enum GenderPreference {
  NoPreference
  FemaleOnly
  MaleOnly
}

enum LeaseType {
  NewLease
  LeaseTakeover
  Sublet
}

enum FurnishedStatus {
  Furnished
  PartiallyFurnished
  Unfurnished
}

// Preset NYU campuses / neighborhoods (KTD5) — exact-match filtering without a
// geocoding/mapping vendor dependency. Extend this list post-launch as needed.
enum Campus {
  WashingtonSquare
  Brooklyn
  Tandon
  Stern
  UnionSquare
  UpperEastSide
  Other
}

// Preset list of popular NYC / Jersey City neighborhoods near NYU campuses
// (KTD5) — same rationale as `Campus`: exact-match filtering, no geocoding.
enum Neighborhood {
  GreenwichVillage
  EastVillage
  WestVillage
  Soho
  Noho
  Nolita
  LittleItaly
  Tribeca
  FinancialDistrict
  BatteryParkCity
  UnionSquare
  Gramercy
  Flatiron
  Chelsea
  HellKitchen
  MidtownEast
  MidtownWest
  LowerEastSide
  Chinatown
  MurrayHill
  KipsBay
  UpperEastSide
  UpperWestSide
  Harlem
  BrooklynHeights
  Dumbo
  DowntownBrooklyn
  BoerumHill
  CobbleHill
  CarrollGardens
  ParkSlope
  ProspectHeights
  BedfordStuyvesant
  CrownHeights
  Bushwick
  Williamsburg
  Greenpoint
  FortGreene
  ClintonHill
  Gowanus
  RedHook
  Astoria
  LongIslandCity
  Sunnyside
  Ridgewood
  JerseyCityDowntown
  JerseyCityHeights
  JournalSquare
  Newport
  GroveStreet
  Hoboken
  Weehawken
  Other
}

model Listing {
  id          String        @id @default(cuid())
  posterEmail String
  status      ListingStatus @default(Active)

  // R10 structured fields
  title                   String
  description             String
  rentCents               Int
  neighborhood            Neighborhood
  campus                  Campus
  // Self-reported distance from the selected campus (R7) — a plain number,
  // not geocoded (KTD5), so it's meaningful alongside `campus`, not instead
  // of it: "campus" says which area, "distanceFromCampusMiles" says how far.
  distanceFromCampusMiles Float            @default(0)
  bedrooms                Int
  bathrooms               Float            @default(1)
  furnishedStatus         FurnishedStatus  @default(Unfurnished)
  moveInDate              DateTime
  // Optional — null means an open-ended/new lease with no known end date.
  leaseEndDate            DateTime?
  leaseType               LeaseType
  guarantorReq            Boolean          @default(false)
  utilitiesIncl           Boolean          @default(false)
  wifiIncl                Boolean          @default(false)
  acIncl                  Boolean          @default(false)
  privateBathroom         Boolean          @default(false)
  laundryIncl             Boolean          @default(false)
  vegPreferred            Boolean          @default(false)
  genderPref              GenderPreference @default(NoPreference)

  // R12 — at least one contact method required (enforced in application code)
  contactWhatsapp String?
  contactEmail    String?
  contactPhone    String?

  photos ListingPhoto[]

  // R19–R21 lifecycle timestamps
  activatedAt   DateTime  @default(now())
  inactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([posterEmail])
  @@index([status, activatedAt])
  @@index([status, inactivatedAt])
}

model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  @@index([listingId])
}
