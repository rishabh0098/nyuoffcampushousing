# Postgres connection string (Neon or any Postgres). See KTD1.
# Production and Preview MUST use separate databases.
DATABASE_URL="postgresql://user:password@localhost:5432/nyuoffcampushousing"

# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
# Use a DIFFERENT value for Production vs Preview.
SESSION_SECRET="replace-with-a-long-random-secret"

# Google OAuth 2.0 Client ID/Secret (Web application type) from Google Cloud
# Console. Prefer separate OAuth clients (or at least distinct redirect URIs)
# for Production vs Preview. Register authorized redirect URIs matching each
# environment, e.g. http://localhost:3000/api/auth/google/callback for local
# dev. See KTD3.
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxx"

# Shared secret the Vercel Cron job sends to authenticate calls to
# /api/cron/expire-listings. See KTD4, U5.
# Use a DIFFERENT value for Production vs Preview.
CRON_SECRET="replace-with-a-long-random-secret"
