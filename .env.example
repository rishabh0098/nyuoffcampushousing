# Postgres connection string (Vercel Postgres or Neon). See KTD1.
DATABASE_URL="postgresql://user:password@localhost:5432/nyuoffcampushousing"

# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

# Resend API key + verified sending domain address. See KTD3.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="NYU Off-Campus Housing <noreply@yourdomain.com>"

# Vercel Blob read/write token for listing photo uploads. See KTD6.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Shared secret the Vercel Cron job sends to authenticate calls to
# /api/cron/expire-listings. See KTD4, U5.
CRON_SECRET="replace-with-a-long-random-secret"
